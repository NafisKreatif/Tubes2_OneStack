@using DOMTreeTraversal.Models.View
@model CssSelectorViewModel
@{
    ViewData["Title"] = "CSS Selector Result";
}

<div class="text-center">
    <h1 class="display-5">@ViewData["Title"]</h1>
    <form method="POST" action="/Home/CssSelectorResult" enctype="multipart/form-data">
        <input type="text" id="cssSelector" name="cssSelector" placeholder="Insert CSS Selector"
               class="my-2 text-md-start w-50 rounded-4 border-3 py-2 px-3" value='@Html.Raw(Model.CssSelector)' />
        <div class="d-flex gap-2 justify-content-center my-2">
            <label for="traversalType" class="my-auto">Traversal Type</label>
            <select id="traversalType" name="traversalType" class="h-75 my-auto" value='@Html.Raw(Model.TraversalType)'>
                <option value="bfs">BFS</option>
                <option value="dfs">DFS</option>
            </select>
            <button type="submit"
                    class="my-2 py-1 px-3 bg-primary border-3 border-success-subtle rounded-3 text-white">Search</button>
        </div>
        <input type="text" id="domTreeJson" name="domTreeJson" value='@Html.Raw(Model.DomTreeJson)' hidden />
    </form>
    <h4 id="maxLevel">Kedalaman Maksimal: </h4>
    <div id="result-tree" class="overflow-x-scroll border border-2">
    </div>
    <canvas width="800" height="600" class="border-2"></canvas>
</div>

<script>
    const rawJson = `@Html.Raw(Model.DomTreeJson)`;
    const safeJson = rawJson.replace("\n", "\\n");
    const htmlTree = JSON.parse(safeJson);
    const traversalOrder = JSON.parse('@Html.Raw(Model.TraversalJson)');
    const selectedNode = JSON.parse('@Html.Raw(Model.SelectedJson)');
    document.getElementById("maxLevel").textContent = "Kedalaman Maksimal: " + htmlTree.MaxLevel;
    window.addEventListener('load', function () {
        let infoMap = new Map();
        build(document.getElementById("result-tree"), htmlTree, infoMap);
        for (let i = 0; i < traversalOrder.length; i++) {
            infoMap[traversalOrder[i]].classList.add("traversed");
        }
        for (let i = 0; i < selectedNode.length; i++) {
            infoMap[selectedNode[i]].classList.add("selected");
        }
    });
</script>